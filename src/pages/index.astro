---
import "../styles/general.css";
import "../styles/index.css"
import Buyticket from "../components/Buyticket.astro";
import Button from "../components/Button.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Card from "../components/Faq.astro"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body>
    <header>
      <div class="logo-wrap">
        <div>KARRUSEL</div>
      </div>

      <div class="menu-wrap">
        <a class="header-button" href="/listview">LINEUP</a>
        <a class="header-button" href="info">INFO</a>
        <a class="header-button" href="map">MAP</a>
        <a class="ticket-cta" href="tickets">TICKETS</a>
      </div>
    </header>
    <main>
   

             <div class="overlay">
                <div class="_28-30-august-2025">28-30 AUGUST 2025</div>
                  <div class="copenhagen">COPENHAGEN</div>
    
    <div class="_3-days-of-house-disco-and-techno-in-the-woods">3 DAYS OF HOUSE, DISCO AND TECHNO IN THE WOODS</div>
  
      <img class="image-2" src="img/image-2.png" />
             </div>
          
			<div class="image"><img class="karrusel" src="img/karrusel2.jpeg" /></div>
			

            <Buyticket
            />
      
      <h1>General Information</h1>
      <section class="information-grid">
        <p>
          Karrusel is a circus themed rave presenting some of the world's
          leading electronic artists.
        </p>
        <p>
          Terms: 18+ event. Karrusel takes place rain or shine. Artists subject
          to change.
        </p>
        <p>
          Opening Hours <br />
          Thursday 22 Aug 2024: 18.00-01.00 <br />
          Friday 23 Aug 2024: 18.00-04.00 <br />
          Saturday 24 Aug 2024: 18.00-03.00
        </p>
      </section>
      <h1>FAQ</h1>
      <section class="card-grid">
        <Card
          header="Can I bring food and drink to the festival?"
          text="Only empty plastic bottles, snacks and fruits are allowed inside"
        />
        <Card
          header="What will there be on site?"
          text="3 music stages, a vintage carousel ride, nice bar and food stands, the witch cave, performances, bonfire, power banks, free water point, merchandise, info stands and much more"
        />
        <Card
          header="Can I bring a backpack, a bag and/or a trolley? "
          text="Only backpacks and soft case bags no bigger than 25x40cm are allowed. Trolleys and hard case bags are not allowed "
        />
        <Card
          header="If I feel unsafe, who can I talk to and where can I go?"
          text="You should reach out to our Awareness Team - they will be weearing a pink vest and walk around the site. You can ask any festival staff and they will guide you to the Awareness Team"
        />
      </section>
      <h1>News Sign-Up</h1>
      <h3>Sign up for festival news, great offers and more information</h3>
      <section class="signup-grid">
        <Button variant="primary" size="medium">Email Address</Button>
        <Button variant="secondary" size="medium">Sign Up</Button>
      </section>
    </main>
    <footer>
      <div class="footer-wrap">
        <a href="/">LINK TO APP</a>
        <a href="/">LINK TO KARRUSEL 2024 SURVEY</a>
        <a href="/">LINK TO "FIND MY FRIENDS" APP</a>
        <a href="/">COPENHAGEN, REFSHALEØEN</a>
      </div>
      <div class="footer-icons">
        <a href=""> <img src="/" alt="Facebook icon" /> </a>
        <a href=""> <img src="/" alt="Instagram icon" /> </a>
      </div>
    </footer>
  </body>
</html>


